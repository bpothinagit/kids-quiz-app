{
  "permissions": {
    "defaultMode": "plan"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "marker=/tmp/kids-quiz-code-review-ok; if [ -f \"$marker\" ] && [ \"$(cat $marker)\" = \"allow\" ]; then echo 'Code review passed.'; else echo 'Error: run /code-review before committing.' >&2; exit 1; fi",
            "if": "Bash(git commit*)",
            "statusMessage": "Checking code review status..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rm -f /tmp/kids-quiz-code-review-ok",
            "if": "Bash(git commit*)",
            "statusMessage": "Clearing review marker..."
          }
        ]
      }
    ]
  }
}
